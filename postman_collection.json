{
  "info": {
    "name": "Сановники — ЛР3",
    "description": "Запросы веб-сервиса «Определение года события по упоминанию сановников». В запросе «Добавление» выберите файлы image и video.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" }
  ],
  "item": [
    {
      "name": "1. Список с фильтром по дате",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/dignitarie_lists?date=1570-01-01",
          "host": ["{{baseUrl}}"],
          "path": ["dignitarie_lists"],
          "query": [
            { "key": "date", "value": "1570-01-01" }
          ]
        }
      }
    },
    {
      "name": "2. Добавление (черновик) с изображением и видео",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "name", "value": "Дмитрий Михайлович Пожарский", "type": "text" },
            { "key": "image", "type": "file", "src": [] },
            { "key": "video", "type": "file", "src": [] }
          ]
        },
        "url": { "raw": "{{baseUrl}}/dignitarie_lists", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists"] }
      }
    },
    {
      "name": "3. Черновик текущего пользователя",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/dignitarie_lists/draft", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists", "draft"] }
      }
    },
    {
      "name": "4. Публикация черновика",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Князь, будущий руководитель Второго ополчения. В 1610–1611 годах воевода Зарайска.\",\n  \"start_date\": \"1610-01-01\",\n  \"end_date\": \"1611-12-31\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/dignitarie_lists/draft/publish", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists", "draft", "publish"] }
      }
    },
    {
      "name": "5. Лента без id",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/dignitarie_lists/feed", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists", "feed"] }
      }
    },
    {
      "name": "6. Лента: следующая после id (?next=true)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/dignitarie_lists/feed?id=1&next=true",
          "host": ["{{baseUrl}}"],
          "path": ["dignitarie_lists", "feed"],
          "query": [
            { "key": "id", "value": "1" },
            { "key": "next", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "7. Лайк",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"liked\": 1\n}" },
        "url": { "raw": "{{baseUrl}}/dignitarie_lists/4/like", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists", "4", "like"] }
      }
    },
    {
      "name": "8. Удаление",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/dignitarie_lists/6", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists", "6"] }
      }
    },
    {
      "name": "9. Регистрация пользователя",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"new_user\",\n  \"password\": \"secret123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/users/register", "host": ["{{baseUrl}}"], "path": ["users", "register"] }
      }
    },
    {
      "name": "10. Аутентификация (заглушка)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"login\": \"new_user\",\n  \"password\": \"secret123\"\n}" },
        "url": { "raw": "{{baseUrl}}/users/login", "host": ["{{baseUrl}}"], "path": ["users", "login"] }
      }
    },
    {
      "name": "11. Деавторизация (заглушка)",
      "request": {
        "method": "POST",
        "url": { "raw": "{{baseUrl}}/users/logout", "host": ["{{baseUrl}}"], "path": ["users", "logout"] }
      }
    }
  ]
}
