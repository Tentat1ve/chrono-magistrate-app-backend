{
  "info": {
    "name": "Сановники — ЛР4",
    "description": "Сначала выполните «Вход»: токен сохранится в переменную {{token}} и подставится в запросы создателя (Bearer). В запросе «Добавление» выберите файлы image и video.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Список (гость)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/dignitarie_lists?date=1570-01-01", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists"], "query": [{ "key": "date", "value": "1570-01-01" }] }
      }
    },
    {
      "name": "2. Лента (гость)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/dignitarie_lists/feed", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists", "feed"] }
      }
    },
    {
      "name": "3. Регистрация",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"login\": \"newuser\",\n  \"password\": \"secret123\"\n}" },
        "url": { "raw": "{{baseUrl}}/users/register", "host": ["{{baseUrl}}"], "path": ["users", "register"] }
      }
    },
    {
      "name": "4. Вход (сохраняет токен)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.access_token) { pm.collectionVariables.set('token', body.access_token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"login\": \"tentative\",\n  \"password\": \"password123\"\n}" },
        "url": { "raw": "{{baseUrl}}/users/login", "host": ["{{baseUrl}}"], "path": ["users", "login"] }
      }
    },
    {
      "name": "5. Лента (с токеном)",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": { "raw": "{{baseUrl}}/dignitarie_lists/feed", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists", "feed"] }
      }
    },
    {
      "name": "6. Добавление (черновик) с изображением и видео",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "name", "value": "Дмитрий Михайлович Пожарский", "type": "text" },
            { "key": "image", "type": "file", "src": [] },
            { "key": "video", "type": "file", "src": [] }
          ]
        },
        "url": { "raw": "{{baseUrl}}/dignitarie_lists", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists"] }
      }
    },
    {
      "name": "7. Черновик",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": { "raw": "{{baseUrl}}/dignitarie_lists/draft", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists", "draft"] }
      }
    },
    {
      "name": "8. Публикация черновика (с токеном)",
      "request": {
        "method": "PUT",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"description\": \"Руководитель Второго ополчения\",\n  \"start_date\": \"1612-01-01\",\n  \"end_date\": \"1612-12-31\"\n}" },
        "url": { "raw": "{{baseUrl}}/dignitarie_lists/draft/publish", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists", "draft", "publish"] }
      }
    },
    {
      "name": "9. Публикация черновика (гость — 401)",
      "request": {
        "method": "PUT",
        "auth": { "type": "noauth" },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"description\": \"Руководитель Второго ополчения\",\n  \"start_date\": \"1612-01-01\",\n  \"end_date\": \"1612-12-31\"\n}" },
        "url": { "raw": "{{baseUrl}}/dignitarie_lists/draft/publish", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists", "draft", "publish"] }
      }
    },
    {
      "name": "10. Лайк",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"liked\": 1\n}" },
        "url": { "raw": "{{baseUrl}}/dignitarie_lists/4/like", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists", "4", "like"] }
      }
    },
    {
      "name": "11. Удаление",
      "request": {
        "method": "DELETE",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": { "raw": "{{baseUrl}}/dignitarie_lists/8", "host": ["{{baseUrl}}"], "path": ["dignitarie_lists", "8"] }
      }
    },
    {
      "name": "12. Выход (токен в чёрный список)",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": { "raw": "{{baseUrl}}/users/logout", "host": ["{{baseUrl}}"], "path": ["users", "logout"] }
      }
    }
  ]
}
